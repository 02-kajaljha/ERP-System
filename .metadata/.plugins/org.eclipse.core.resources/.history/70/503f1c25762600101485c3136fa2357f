<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - ERP</title>
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #4facfe, #00f2fe);
            height: 100vh;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .login-container {
            background: #fff;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.15);
            width: 350px;
            text-align: center;
        }

        .login-container h2 {
            color: #333;
            margin-bottom: 25px;
        }

        .login-container input {
            width: 100%;
            padding: 14px;
            margin: 10px 0;
            border: 1px solid #ddd;
            border-radius: 8px;
            transition: 0.3s;
        }

        .login-container input:focus {
            outline: none;
            border-color: #4facfe;
            box-shadow: 0 0 5px #4facfe;
        }

        .login-container button {
            width: 100%;
            padding: 14px;
            background: linear-gradient(90deg, #00c6ff, #0072ff);
            color: #fff;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
        }

        .login-container button:hover {
            background: linear-gradient(90deg, #0072ff, #00c6ff);
        }

        .login-container p {
            margin-top: 15px;
            font-size: 14px;
            color: #666;
        }

        .login-container a {
            color: #0072ff;
            text-decoration: none;
        }

        .error-message,
        .success-message {
            margin-top: 12px;
            font-size: 14px;
        }

        .error-message { color: #e74c3c; }
        .success-message { color: #2ecc71; }
    </style>
</head>
<body>
    <div class="login-container">
        <h2>Login</h2>
        <form action="/login" method="POST">
            <input type="text" name="username" placeholder="User ID" required />
            <input type="password" name="password" placeholder="Password" required />
            <button type="submit">Login</button>
        </form>
        <p class="error-message" id="error-message" style="display:none;">Invalid username or password.</p>
        <p class="success-message" id="success-message" style="display:none;">You have been logged out successfully!</p>
        <p>Don't have an account? <a href="/register">Register here</a></p>
    </div>

    <script>
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('error')) {
            document.getElementById('error-message').style.display = 'block';
        } else if (urlParams.has('logout')) {
            document.getElementById('success-message').style.display = 'block';
        }
    </script>
</body>
</html>
