<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome - Student ERP</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f7f9fc;
            color: #333;
            line-height: 1.6;
        }
        header {
            background-color: #007BFF;
            color: white;
            text-align: center;
            padding: 30px 0;
            border-bottom: 3px solid #0056b3;
        }
        h1 {
            margin: 0;
            font-size: 2.5em;
        }
        .container {
            max-width: 1200px;
            margin: 30px auto;
            padding: 20px;
            background-color: white;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            border-radius: 10px;
        }
        .student-info {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        .student-info div {
            padding: 20px;
            background-color: #f9f9f9;
            border-radius: 10px;
            border: 1px solid #ddd;
            transition: all 0.3s ease-in-out;
        }
        .student-info div:hover {
            background-color: #e9f1ff;
            border-color: #007BFF;
        }
        h3 {
            font-size: 1.2em;
            color: #007BFF;
            margin-bottom: 8px;
        }
        p {
            font-size: 1.1em;
            color: #555;
        }
        .logout-btn {
            display: inline-block;
            background-color: #FF5733;
            color: white;
            padding: 12px 25px;
            border-radius: 25px;
            text-align: center;
            text-decoration: none;
            font-size: 1.1em;
            margin-top: 30px;
            transition: background-color 0.3s ease;
        }
        .logout-btn:hover {
            background-color: #e04e2a;
        }
        .logout-btn:active {
            background-color: #c83e1d;
        }
    </style>
</head>
<body>
    <header>
        <h1>Welcome to the Student ERP System</h1>
    </header>
    
    <div class="container">
        <h2 style="text-align: center; color: #007BFF;">Welcome, John Doe!</h2>
        <p style="text-align: center; font-size: 1.1em; color: #555;">Below are your details:</p>
        
        <div class="student-info">
            <div>
                <h3>Student ID</h3>
                <p>12345678</p>
            </div>
            <div>
                <h3>Email</h3>
                <p>johndoe@example.com</p>
            </div>
            <div>
                <h3>Father's Name</h3>
                <p>Robert Doe</p>
            </div>
            <div>
                <h3>Mother's Name</h3>
                <p>Linda Doe</p>
            </div>
            <div>
                <h3>Date of Birth</h3>
                <p>2000-01-01</p>
            </div>
            <div>
                <h3>College</h3>
                <p>XYZ Engineering College</p>
            </div>
            <div>
                <h3>Course</h3>
                <p>B.Tech Computer Science</p>
            </div>
            <div>
                <h3>Year</h3>
                <p>3rd Year</p>
            </div>
            <div>
                <h3>Branch</h3>
                <p>CSE</p>
            </div>
            <div>
                <h3>Section</h3>
                <p>A</p>
            </div>
            <div>
                <h3>Class Roll No</h3>
                <p>21</p>
            </div>
            <div>
                <h3>University Roll No</h3>
                <p>190041021</p>
            </div>
            <div>
                <h3>High School %</h3>
                <p>90.5%</p>
            </div>
            <div>
                <h3>Intermediate %</h3>
                <p>89.2%</p>
            </div>
            <div>
                <h3>Role</h3>
                <p>Student</p>
            </div>
        </div>

        <a href="/logout" class="logout-btn">Logout</a>
    </div>
</body>
</html>
